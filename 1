    .tag.off { background: #f5f5f5; border: 1.5px solid #e0e0e0; color: var(--gris-sub); }
    .targ-res { margin-top: 18px; padding: 14px 18px; background: #f0fdf4; border: 1.5px solid #86efac; border-radius: 12px; display: flex; align-items: center; justify-content: space-between; }
    .targ-rl { font-size: .8125rem; color: var(--gris-txt); font-weight: 500; }
    .targ-rn { font-family: var(--fd); font-weight: 800; color: var(--vert-d); font-size: 1.25rem; }
