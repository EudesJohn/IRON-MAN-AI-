    .targ-feats { display: flex; flex-direction: column; gap: 11px; }
    .tarf { display: flex; align-items: flex-start; gap: 11px; font-size: .9rem; color: var(--gris-txt); line-height: 1.5; }
    .tarf svg { flex-shrink: 0; margin-top: 2px; color: var(--vert); }

    /* ── CAMPAIGN CARDS ── */
    .camp-g { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
    .camp-c { border-radius: 26px; padding: 38px; position: relative; overflow: hidden; }
    .camp-c.feat { background: linear-gradient(135deg, var(--vert-d) 0%, var(--vert) 100%); border: 1px solid rgba(255,255,255,.1); }
    .camp-c.sec  { background: var(--blanc); border: 1.5px solid var(--gris-bd); }
    .camp-bdg { display: inline-block; font-size: .6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; padding: 5px 12px; border-radius: 100px; margin-bottom: 20px; }
    .camp-c.feat .camp-bdg { background: rgba(255,255,255,.2); color: rgba(255,255,255,.9); }
    .camp-c.sec  .camp-bdg { background: #f0fdf4; color: var(--vert-d); border: 1.5px solid #86efac; }
    .camp-ico { font-size: 2.25rem; margin-bottom: 16px; }
    .camp-title { font-size: 1.5rem; font-weight: 800; margin-bottom: 7px; letter-spacing: -.02em; }
    .camp-c.feat .camp-title { color: var(--blanc); }
    .camp-c.sec  .camp-title { color: var(--noir); }
    .camp-sub { font-size: .9375rem; margin-bottom: 20px; line-height: 1.5; }
    .camp-c.feat .camp-sub { color: rgba(255,255,255,.75); }
    .camp-c.sec  .camp-sub { color: var(--gris-txt); }
    .camp-feats { list-style: none; display: flex; flex-direction: column; gap: 9px; margin-bottom: 26px; }
    .camp-feats li { display: flex; align-items: center; gap: 9px; font-size: .875rem; }
    .camp-feats li::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: currentColor; opacity: .6; flex-shrink: 0; }
    .camp-c.feat .camp-feats li { color: rgba(255,255,255,.85); }
    .camp-c.sec  .camp-feats li { color: var(--gris-txt); }
    .camp-cta { display: inline-flex; align-items: center; gap: 7px; padding: 12px 22px; border-radius: 12px; font-weight: 700; font-size: .9rem; transition: all var(--tr); }
    .camp-c.feat .camp-cta { background: rgba(255,255,255,.2); color: var(--blanc); border: 1px solid rgba(255,255,255,.25); }
    .camp-c.feat .camp-cta:hover { background: rgba(255,255,255,.3); }
    .camp-c.sec  .camp-cta { background: #f0fdf4; color: var(--vert-d); border: 1.5px solid #86efac; }
    .camp-c.sec  .camp-cta:hover { background: #dcfce7; }

    /* ── PROOF / PHONE ── */
    .proof-g { display: grid; grid-template-columns: 1fr 1fr; gap: 72px; align-items: center; }
    .phone-w { display: flex; justify-content: center; position: relative; }
    .phone { width: 330px; background: #1C1C1E; border-radius: 46px; padding: 14px; box-shadow: 0 60px 120px rgba(0,0,0,.6), 0 0 0 1px rgba(255,255,255,.08); position: relative; }
    .phone::before { content: ''; position: absolute; top: 11px; left: 50%; transform: translateX(-50%); width: 76px; height: 6px; background: #2C2C2E; border-radius: 3px; }
    .phone-scr { border-radius: 34px; overflow: hidden; background: #000; }
    .phone-scr img { width: 100%; height: auto; display: block; }
    .phone-bdg { position: absolute; bottom: -10px; right: -18px; background: var(--vert); color: var(--blanc); border-radius: 14px; padding: 12px 16px; box-shadow: 0 8px 24px rgba(0,165,60,.45); }
    .phone-bdg-n { font-family: var(--fd); font-weight: 800; font-size: 1.375rem; letter-spacing: -.02em; }
    .phone-bdg-l { font-size: .6875rem; font-weight: 600; opacity: .9; white-space: nowrap; }
    .phone-glow { position: absolute; bottom: -40px; left: 50%; transform: translateX(-50%); width: 220px; height: 80px; background: rgba(0,165,60,.25); filter: blur(48px); border-radius: 50%; }
    .proof-c h2 { font-size: clamp(1.875rem,3vw,2.5rem); font-weight: 800; letter-spacing: -.03em; margin-bottom: 18px; color: var(--blanc); }
    .proof-c > p { font-size: 1.0625rem; color: rgba(255,255,255,.72); line-height: 1.7; margin-bottom: 26px; }
    .proof-pts { display: flex; flex-direction: column; gap: 11px; }
    .proof-pt { display: flex; align-items: flex-start; gap: 13px; font-size: .9rem; color: rgba(255,255,255,.75); line-height: 1.5; }
    .pchk { width: 22px; height: 22px; border-radius: 50%; background: rgba(110,255,160,.15); border: 1px solid rgba(110,255,160,.35); display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 1px; }

    /* ── ANTI-FRAUD ── */
    .fraud-g { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
    .fraud-c h2 { font-size: clamp(1.75rem,2.5vw,2.375rem); font-weight: 800; letter-spacing: -.03em; margin-bottom: 14px; }
    .fraud-c > p { font-size: 1.0625rem; color: var(--gris-txt); line-height: 1.7; margin-bottom: 24px; }
    .fraud-bdg { display: inline-flex; align-items: center; gap: 12px; background: #f0fdf4; border: 1.5px solid #86efac; border-radius: 14px; padding: 14px 20px; }
    .fraud-bdg-ico { font-size: 1.875rem; }
    .fraud-bdg-t strong { display: block; font-size: 1.2rem; font-weight: 800; color: var(--vert-d); letter-spacing: -.02em; }
    .fraud-bdg-t span { font-size: .8125rem; color: var(--gris-txt); }
    .fraud-chks { display: flex; flex-direction: column; gap: 10px; }
    .fchk { display: flex; align-items: flex-start; gap: 13px; background: var(--blanc); border: 1.5px solid var(--gris-bd); border-radius: 14px; padding: 14px 18px; transition: border-color var(--tr); }
    .fchk:hover { border-color: var(--vert); }
    .fchk-ico { font-size: 1.2rem; flex-shrink: 0; margin-top: 1px; }
    .fchk-t strong { display: block; font-size: .9rem; font-weight: 700; color: var(--noir); margin-bottom: 2px; }
    .fchk-t span { font-size: .8125rem; color: var(--gris-txt); line-height: 1.4; }

    /* ── DASHBOARD MOCKUP ── */
    .dash-mock { background: var(--blanc); border: 1.5px solid var(--gris-bd); border-radius: 20px; padding: 24px; box-shadow: 0 8px 32px rgba(0,100,40,.08); overflow: hidden; }
    .dash-mock-hdr { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
    .dash-mock-ttl { font-size: .875rem; font-weight: 700; color: var(--noir); }
    .dash-mock-badge { background: #f0fdf4; color: var(--vert-d); font-size: .7rem; font-weight: 700; padding: 3px 10px; border-radius: 100px; border: 1px solid #86efac; }
    .dash-stats-row { display: grid; grid-template-columns: repeat(3,1fr); gap: 10px; margin-bottom: 18px; }
    .dash-stat { background: var(--gris-bg); border-radius: 12px; padding: 14px 16px; }
    .dash-stat-n { font-family: var(--fd); font-size: 1.375rem; font-weight: 800; color: var(--vert-d); letter-spacing: -.03em; }
    .dash-stat-l { font-size: .7rem; color: var(--gris-sub); margin-top: 3px; font-weight: 500; }
    .dash-bar-wrap { margin-bottom: 14px; }
    .dash-bar-lbl { display: flex; justify-content: space-between; font-size: .75rem; color: var(--gris-sub); margin-bottom: 6px; font-weight: 500; }
    .dash-bar { height: 8px; background: var(--gris-bg); border-radius: 100px; overflow: hidden; }
    .dash-bar-fill { height: 100%; border-radius: 100px; background: linear-gradient(to right, var(--vert-d), var(--vert-l)); }
    .dash-rows { display: flex; flex-direction: column; gap: 8px; }
    .dash-row { display: flex; align-items: center; justify-content: space-between; padding: 10px 12px; background: var(--gris-bg); border-radius: 10px; }
    .dash-row-name { font-size: .8125rem; font-weight: 600; color: var(--noir); }
    .dash-row-val { font-family: var(--fm); font-size: .8125rem; color: var(--vert-d); font-weight: 500; }
    .dash-feats { display: flex; flex-direction: column; gap: 12px; }
    .df { display: flex; align-items: flex-start; gap: 13px; }
    .df-ico { width: 42px; height: 42px; border-radius: 12px; background: #f0fdf4; border: 1px solid #bbf7d0; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 1.2rem; }
    .df-t strong { display: block; font-size: .9375rem; font-weight: 700; color: var(--noir); margin-bottom: 3px; }
    .df-t span { font-size: .8125rem; color: var(--gris-txt); line-height: 1.5; }

    /* ── PRICING ── */
    .price-main { display: grid; grid-template-columns: auto 1fr; gap: 36px; align-items: center; background: var(--vert-xd); border-radius: 24px; padding: 36px 40px; margin-bottom: 28px; }
    .price-big-num { font-family: var(--fd); font-size: clamp(3rem,6vw,4.5rem); font-weight: 800; color: var(--or); letter-spacing: -.04em; line-height: 1; }
    .price-big-lbl { font-size: 1rem; font-weight: 600; color: rgba(255,255,255,.8); margin-top: 6px; }
    .price-billing-note { font-size: .8125rem; color: var(--or); font-weight: 600; margin-top: 8px; }
    .price-formula-lbl { font-size: .8125rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: rgba(255,255,255,.5); margin-bottom: 12px; }
    .price-formula { background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.15); border-left: 4px solid var(--or); border-radius: 10px; padding: 16px 20px; font-family: var(--fm); font-size: clamp(.75rem,1.5vw,.9375rem); color: rgba(255,255,255,.9); line-height: 1.6; }
    /* Sim cards */
    .sim-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 16px; margin-bottom: 20px; }
    .sim-card { background: var(--blanc); border: 1.5px solid var(--gris-bd); border-radius: 20px; padding: 28px 24px; text-align: center; position: relative; }
    .sim-card--featured { background: var(--vert-d); border-color: var(--vert-d); }
    .sim-badge { position: absolute; top: -12px; left: 50%; transform: translateX(-50%); background: var(--or); color: var(--noir); font-size: .7rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; padding: 4px 14px; border-radius: 100px; white-space: nowrap; }
    .sim-name { font-family: var(--fd); font-size: 1.125rem; font-weight: 800; color: var(--noir); margin-bottom: 14px; }
    .sim-card--featured .sim-name { color: var(--or); }
    .sim-calc { font-size: .8125rem; color: var(--gris-sub); line-height: 1.6; margin-bottom: 16px; }
    .sim-card--featured .sim-calc { color: rgba(255,255,255,.7); }
    .sim-total { font-family: var(--fd); font-size: 1.75rem; font-weight: 800; color: var(--vert-d); letter-spacing: -.03em; margin-bottom: 10px; }
    .sim-card--featured .sim-total { color: var(--blanc); }
    .sim-desc { font-size: .8125rem; color: var(--gris-sub); line-height: 1.5; }
    .sim-card--featured .sim-desc { color: rgba(255,255,255,.65); }
    .sim-footer { text-align: center; font-size: .8125rem; color: var(--gris-sub); margin-bottom: 28px; }
    .sim-footer::before { content: '★ '; color: var(--vert); }
    .price-hl { background: #f0fdf4; border: 1.5px solid #86efac; border-radius: 14px; padding: 16px 20px; text-align: center; margin-bottom: 28px; font-size: .9375rem; color: var(--gris-txt); line-height: 1.6; }
    .price-hl strong { color: var(--vert-d); }
    .btn-p { display: inline-flex; align-items: center; gap: 8px; background: var(--vert); color: var(--blanc); font-family: var(--fb); font-weight: 800; font-size: 1rem; padding: 16px 32px; border-radius: 14px; transition: all var(--tr); }
    .btn-p:hover { background: var(--vert-l); transform: translateY(-2px); box-shadow: 0 12px 36px rgba(0,165,60,.3); }

    /* ── FAQ ── */
    .faq-list { max-width: 720px; margin: 0 auto; display: flex; flex-direction: column; gap: 10px; }
    .faq-i { background: var(--blanc); border: 1.5px solid var(--gris-bd); border-radius: 14px; overflow: hidden; transition: border-color var(--tr); }
    .faq-i:hover, .faq-i.open { border-color: var(--vert); }
    .faq-q { display: flex; align-items: center; justify-content: space-between; padding: 18px 22px; cursor: pointer; font-size: .9375rem; font-weight: 700; color: var(--noir); user-select: none; gap: 16px; }
    .faq-tog { width: 28px; height: 28px; border-radius: 50%; background: var(--gris-bg); display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: all var(--tr); }
    .faq-i.open .faq-tog { background: var(--vert); transform: rotate(45deg); }
    .faq-i.open .faq-tog svg { color: var(--blanc); }
    .faq-ans { max-height: 0; overflow: hidden; transition: max-height .4s ease; }
    .faq-i.open .faq-ans { max-height: 240px; }
    .faq-ans-in { padding: 0 22px 18px; font-size: .875rem; color: var(--gris-txt); line-height: 1.7; }

    /* ── FINAL CTA ── */
    .fcta { background: linear-gradient(160deg, var(--vert-xd) 0%, var(--vert-d) 50%, var(--vert) 100%); position: relative; overflow: hidden; }
    .fcta::before { content: ''; position: absolute; inset: 0; background: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E"); opacity: .04; }
    .fcta-in { position: relative; text-align: center; padding: 96px 0; }
    .fcta-in h2 { font-size: clamp(2rem,4vw,3.25rem); font-weight: 800; color: var(--blanc); letter-spacing: -.03em; margin-bottom: 16px; line-height: 1.1; }
    .fcta-in > p { font-size: 1.125rem; color: rgba(255,255,255,.78); margin-bottom: 38px; max-width: 480px; margin-left: auto; margin-right: auto; }
    .btn-w { background: var(--blanc); color: var(--vert-d); font-family: var(--fb); font-weight: 800; font-size: 1.0625rem; padding: 18px 40px; border-radius: 14px; display: inline-flex; align-items: center; gap: 10px; transition: all var(--tr); }
    .btn-w:hover { background: #e6f9ed; transform: translateY(-2px); box-shadow: 0 16px 40px rgba(0,0,0,.2); }
    .fcta-note { margin-top: 20px; font-size: .875rem; color: rgba(255,255,255,.55); }
    .fcta-note span { margin: 0 7px; opacity: .5; }

    /* ── FOOTER ── */
    .footer { background: var(--vert-xd); border-top: 1px solid rgba(255,255,255,.08); padding: 40px 0; }
    .footer-in { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; }
    .footer-logo img { height: 32px; width: auto; filter: brightness(0) invert(1); }
    .footer-links { display: flex; gap: 22px; }
    .footer-links a { font-size: .875rem; color: rgba(255,255,255,.6); transition: color var(--tr); }
    .footer-links a:hover { color: var(--blanc); }
    .footer-copy { font-size: .8125rem; color: rgba(255,255,255,.4); }

    /* ── RESPONSIVE ── */
    @media(max-width:1024px) {
      .steps-g { grid-template-columns: repeat(2,1fr); gap: 28px; }
      .steps-g::before { display: none; }
      .dash-stats-row { grid-template-columns: 1fr 1fr; }
    }
    @media(max-width:768px) {
      .section { padding: 64px 0; }
      .container { padding: 0 16px; }
      .hero-title { font-size: 2.25rem; }
      .hero-sub { font-size: 1rem; }
      .pitch-g, .targ-g, .proof-g, .fraud-g { grid-template-columns: 1fr; }
      .proof-g .phone-w { order: -1; }
      .camp-g { grid-template-columns: 1fr; }
      .stats-g { grid-template-columns: repeat(2,1fr); gap: 28px; }
      .stat-i+.stat-i::before { display: none; }
      .steps-g { grid-template-columns: 1fr; }
      .steps-g::before { display: none; }
      .footer-in { flex-direction: column; text-align: center; }
      .footer-links { flex-wrap: wrap; justify-content: center; }
      /* Pricing mobile */
      .price-main { grid-template-columns: 1fr; gap: 24px; padding: 28px 24px; }
      .sim-grid { grid-template-columns: 1fr; }
      .price-formula { font-size: .75rem; }
    }
  </style>
</head>
