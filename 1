    .btn-w { background: var(--blanc); color: var(--vert-d); font-family: var(--fb); font-weight: 800; font-size: 1.0625rem; padding: 18px 40px; border-radius: 14px; display: inline-flex; align-items: center; gap: 10px; transition: all var(--tr); }
